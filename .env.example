# =============================================================================
#  Stack configuration - the ONE file you edit by hand.
# =============================================================================
#  `make env` copies this to .env and fills every __GENERATE__ marker with a
#  fresh random secret. Existing values in .env are NEVER overwritten, which is
#  what makes `make buildprod` safe to re-run against a live server.
#
#  The containers read this file through compose; the Nuxt apps and the e2e
#  runner get DERIVED files (frontend/.env, manager/.env, landing/.env, e2e/.env)
#  written by `make env`, never by hand - so hostnames, CORS origins and the
#  Mercure URL cannot disagree. The Go backend has no env file of its own: its
#  environment is composed in docker/compose.dev.yml from the values here.
#  See .ai/platform/docs/dev-stack.md.
# =============================================================================

# ── Identity ─────────────────────────────────────────────────────────────────
# Changed by `make init NAME=...`, not by hand.
PROJECT_NAME=OpenEnuGo
PROJECT_SLUG=open-enu-go

# ── Host identity (filled automatically by `make env`) ──────────────────────
# The Nuxt dev containers and the e2e runner write into the bind-mounted source
# as this uid/gid so the files belong to you, not to root.
HOST_UID=1000
HOST_GID=1000

# ── Environment ──────────────────────────────────────────────────────────────
# APP_STAGE : where this checkout runs - `local`, `staging` or `production`.
#             Staging is the DEV stack on a server (hot reload, Mailpit), so you
#             can vibe code on it; production is immutable images. Chooses the
#             edge's mode (the local dev CA, or ACME with security headers and a
#             rate limit), the compose files on a server (scripts/lib/stage.sh),
#             whether the landing site may be indexed (production only), what
#             release.sh and promote.sh accept, and the stage /health reports.
APP_STAGE=local

# ── Stack ────────────────────────────────────────────────────────────────────
# STACK        : the compose project, and the prefix of every container, network,
#                volume and router. Locally the project slug; on a server
#                <slug>-staging or <slug>-prod, so both stages can share one box.
# COMPOSE_FILE : compose's own variable, so a bare `docker compose ps` in the
#                checkout reads the right files. Staging on a server is
#                `docker/compose.dev.yml:docker/compose.staging.yml`. Each file
#                brings the project's own of the same name from docker/project/
#                when there is one (scripts/lib/compose.sh).
STACK=open-enu-go
COMPOSE_FILE=docker/compose.dev.yml

# STAGING_ALLOW_FROM : who may reach a STAGING server at all - comma-separated
#                      IPs or CIDRs. Staging runs the dev stack, which must
#                      never be public. Provisioning fills in the address you
#                      connected from.
STAGING_ALLOW_FROM=

# SSH_ALLOW_FROM : who may reach port 22 on the server - comma-separated IPs or
#                  CIDRs, applied by `make build*` to ufw. Empty = anywhere
#                  (fail2ban guards it, and provisioning warns). Provisioning
#                  refuses a list that leaves out the address it runs from.
SSH_ALLOW_FROM=

# ── Domain ───────────────────────────────────────────────────────────────────
# One base domain drives every host: the apex is the landing page, and
# app./manager./api./mail. hang off it. Changing this is the only edit needed
# to move the whole stack to another domain.
DOMAIN=open-enu-go.local

# ── Language ─────────────────────────────────────────────────────────────────
# What someone sees before they have chosen: the apps' default language, and
# the language of an error to a client with no preference. One of the shipped
# catalogues (en, pl).
DEFAULT_LOCALE=en

# ── Demonstration content ────────────────────────────────────────────────────
# The platform ships a reference module ("Example") that exists to be read and
# copied, and its browser tests stand on it, so it stays in the code. This only
# decides whether the tenant app OFFERS it: `true` shows it in the menu. Off
# unless asked for, and always off when APP_STAGE=production, whatever this
# says (scripts/lib/envgen.sh).
DEMO_CONTENT=false

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# DB_USER owns the schema and runs migrations. The application connects as
# ${DB_USER}_app - NOSUPERUSER, NOBYPASSRLS - so the row-level policies that
# enforce tenant isolation bind it (ADR-0009). Created by docker/postgres/init.
DB_NAME=open_enu_go
DB_USER=open_enu_go
DB_PASSWORD=__GENERATE__
DB_APP_PASSWORD=__GENERATE__
# Published on the host in dev only. The one port a second project on the same
# Docker host must change - routing is shared through the edge, this is not.
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=__GENERATE__

# ── Application secrets ──────────────────────────────────────────────────────
# APP_SECRET          : signs access tokens (HS256) and storage URLs. At least
#                       32 characters, or the binary refuses to start.
# MERCURE_PUBLISHER_JWT_SECRET  : signs the backend's publish tokens. Never
#                                 leaves the backend and the hub.
# MERCURE_SUBSCRIBER_JWT_SECRET : signs the subscriber cookie every browser
#                                 holds. Two keys so that one cannot do the
#                                 other's job; replacing either only ends open
#                                 SSE connections, which reconnect.
# APP_ENCRYPTION_KEY  : master key for encrypted columns. Per-tenant data keys
#                       are derived from it by HKDF, so losing it loses the data.
#                       It is included in the encrypted backup bundle.
APP_SECRET=__GENERATE__
MERCURE_PUBLISHER_JWT_SECRET=__GENERATE__
MERCURE_SUBSCRIBER_JWT_SECRET=__GENERATE__
APP_ENCRYPTION_KEY=__GENERATE__

# ── Health ───────────────────────────────────────────────────────────────────
# HEALTH_TOKEN : /health/deep (readiness - it pings the database) answers only a
#                request whose X-Health-Token header carries this value; anyone
#                else gets a 404. An external uptime monitor sends the header.
#                Empty: only loopback and private addresses are answered.
#                /health (liveness) is public and needs nothing.
HEALTH_TOKEN=__GENERATE__

# ── Mail ─────────────────────────────────────────────────────────────────────
# Dev captures everything in Mailpit. Production REFUSES TO START without a real
# DSN - silently dropping mail in production is worse than failing loudly.
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=noreply@open-enu-go.local
MAILER_REPLY_TO=support@open-enu-go.local

# ── File storage ─────────────────────────────────────────────────────────────
# Files live on the `storage` volume (storage.Local); there is no S3 backend.
# STORAGE_MAX_UPLOAD_MB: the largest single upload the API accepts.
STORAGE_MAX_UPLOAD_MB=25

# ── Backups (REQUIRED for `make buildprod`, optional for staging) ────────────
# BACKUP_REMOTE     : any rclone remote, e.g. `s3:my-bucket/open-enu-go`.
# BACKUP_AGE_PUBKEY : age public key the nightly dump is encrypted to. Keep the
#                     private half somewhere that is NOT this server.
BACKUP_REMOTE=
BACKUP_AGE_PUBKEY=
BACKUP_AGE_KEY_FILE=
# ALERT_EMAIL       : where a failed nightly backup or a stack that did not
#                     start is reported (scripts/remote/notify.sh), through the
#                     host's sendmail. Empty = LETSENCRYPT_EMAIL.
ALERT_EMAIL=

# ── TLS ──────────────────────────────────────────────────────────────────────
# LETSENCRYPT_EMAIL : where expiry warnings go. Required in production.
# LE_CA_SERVER      : the ACME directory. Point it at
#                     https://acme-staging-v02.api.letsencrypt.org/directory
#                     while debugging DNS - five failed authorisations an hour
#                     locks a hostname out for a week.
LETSENCRYPT_EMAIL=
LE_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# ═════════════════════════════════════════════════════════════════════════════
#  Everything below the next line is the PROJECT's: the credentials of the
#  third parties this product talks to. compose hands each one to the backend
#  as it is; the platform never needs to know its name. Add a variable with a
#  comment and a safe default, like any other.
# ═════════════════════════════════════════════════════════════════════════════
# == Project variables ==
