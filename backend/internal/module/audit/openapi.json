{
  "openapi": "3.0.3",
  "paths": {
    "/api/audit": {
      "get": {
        "operationId": "get_audit_index",
        "summary": "This workspace's trail, newest first. Requires `audit.view`.",
        "tags": [
          "audit"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Up to `limit` entries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditEntry": {
        "type": "object",
        "description": "One audit entry as the kernel wrote it (ADR-0013): both snapshots, the actor and whoever they acted for.",
        "required": [
          "id",
          "action",
          "tenantId",
          "actorId",
          "onBehalfOfId",
          "subjectId",
          "requestId",
          "succeeded",
          "failureReason",
          "before",
          "after",
          "context",
          "recordedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "tenantId": {
            "type": "string",
            "nullable": true
          },
          "actorId": {
            "type": "string",
            "nullable": true
          },
          "onBehalfOfId": {
            "type": "string",
            "nullable": true
          },
          "subjectId": {
            "type": "string",
            "nullable": true
          },
          "requestId": {
            "type": "string",
            "nullable": true
          },
          "succeeded": {
            "type": "boolean"
          },
          "failureReason": {
            "type": "string",
            "nullable": true
          },
          "before": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true
          },
          "after": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true
          },
          "context": {
            "type": "object",
            "additionalProperties": true
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuditList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            }
          }
        }
      }
    }
  }
}