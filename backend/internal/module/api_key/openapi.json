{
  "openapi": "3.0.3",
  "paths": {
    "/api/api-keys": {
      "get": {
        "operationId": "get_api_key_index",
        "summary": "This tenant's keys, newest first. Requires `api_key.view`.",
        "tags": [
          "api_key"
        ],
        "responses": {
          "200": {
            "description": "Every key, revoked ones included; never a secret.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "post_api_key_create",
        "summary": "Mint a key. Requires `api_key.manage`. The secret is in this response and nowhere else, ever.",
        "tags": [
          "api_key"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApiKey"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The key, with its secret.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedApiKey"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/api-keys/{id}": {
      "delete": {
        "operationId": "delete_api_key_revoke",
        "summary": "Revoke a key: it stops authenticating at once and stays in the list. Requires `api_key.manage`.",
        "tags": [
          "api_key"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Revoked"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiKey": {
        "type": "object",
        "required": [
          "id",
          "name",
          "prefix",
          "permissions",
          "revoked",
          "expiresAt",
          "lastUsedAt",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string",
            "description": "The first characters of the secret, to tell keys apart."
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "revoked": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreatedApiKey": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiKey"
          },
          {
            "type": "object",
            "required": [
              "secret",
              "warning"
            ],
            "properties": {
              "secret": {
                "type": "string"
              },
              "warning": {
                "type": "string"
              }
            }
          }
        ]
      },
      "ApiKeyList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiKey"
            }
          }
        }
      },
      "CreateApiKey": {
        "type": "object",
        "required": [
          "name",
          "permissions"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "A non-empty subset of the permissions modules declare."
          },
          "expiresInDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3650
          }
        }
      },
      "Revoked": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "revoked"
            ]
          }
        }
      }
    }
  }
}