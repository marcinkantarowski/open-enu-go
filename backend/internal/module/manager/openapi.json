{
  "openapi": "3.0.3",
  "paths": {
    "/api/manager/login": {
      "post": {
        "operationId": "post_manager_login",
        "summary": "Operator login: the strictest rate limit in the system, no refresh, no reset, no registration.",
        "tags": [
          "manager"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorSession"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManagerLoginRequest"
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/manager/tenants": {
      "get": {
        "operationId": "get_manager_tenant_index",
        "summary": "Every workspace on the platform, newest first, with member counts.",
        "tags": [
          "manager"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagedTenantList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ]
      },
      "post": {
        "operationId": "post_manager_tenant_create",
        "summary": "Create a workspace, active at once, with every module's defaults.",
        "tags": [
          "manager"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenantRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedTenant"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/manager/tenants/{id}": {
      "get": {
        "operationId": "get_manager_tenant_show",
        "summary": "One workspace and its members.",
        "tags": [
          "manager"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagedTenantDetail"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/manager/tenants/{id}/suspend": {
      "post": {
        "operationId": "post_manager_tenant_suspend",
        "summary": "Suspend a workspace: its members and keys stop authenticating.",
        "tags": [
          "manager"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Suspended"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/manager/tenants/{tenantId}/users/{userId}/impersonate": {
      "post": {
        "operationId": "post_manager_impersonate",
        "summary": "Mint a tenant-realm session for a member, marked and naming the operator (ADR-0020). Audited before the token exists.",
        "tags": [
          "manager"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImpersonatedSession"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/manager/audit": {
      "get": {
        "operationId": "get_manager_audit_index",
        "summary": "The trail across every workspace, or one of them.",
        "tags": [
          "manager"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagerAuditList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "tenantId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          }
        ]
      }
    },
    "/api/manager/workers": {
      "get": {
        "operationId": "get_manager_worker_status",
        "summary": "What is waiting and what has failed in the job queues.",
        "tags": [
          "manager"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkerStatus"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/manager/operators": {
      "get": {
        "operationId": "get_manager_operators",
        "summary": "Every operator of the platform.",
        "tags": [
          "manager"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/manager/consultants": {
      "get": {
        "operationId": "get_manager_consultants",
        "summary": "Every consultant, with the workspaces they serve.",
        "tags": [
          "manager"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsultantList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/manager/tenants/{tenantId}/consultants/{userId}": {
      "delete": {
        "operationId": "delete_manager_tenant_consultant",
        "summary": "Remove a consultant from a workspace. Needs a super operator.",
        "tags": [
          "manager"
        ],
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsultantChanged"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/manager/tenants/{id}/members": {
      "post": {
        "operationId": "post_manager_tenant_member",
        "summary": "Add a person to a workspace, with an account if they have none. Needs a super operator.",
        "tags": [
          "manager"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMemberRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddedMember"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ManagerLoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Operator": {
        "type": "object",
        "required": [
          "id",
          "email",
          "displayName",
          "roles",
          "active",
          "status",
          "lastLoginAt",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "active": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OperatorSession": {
        "type": "object",
        "required": [
          "token",
          "expiresIn",
          "manager"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "HS256 access token, aud manager, 15 minutes. No refresh: a lapsed session means logging in again."
          },
          "expiresIn": {
            "type": "integer"
          },
          "manager": {
            "$ref": "#/components/schemas/Operator"
          }
        }
      },
      "ManagedTenant": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "status",
          "plan",
          "defaultLocale",
          "version",
          "createdAt",
          "activatedAt",
          "members",
          "consultants"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          },
          "defaultLocale": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "activatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "members": {
            "type": "integer"
          },
          "consultants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Who serves it, by name or address."
          }
        }
      },
      "ListMeta": {
        "type": "object",
        "required": [
          "total",
          "page",
          "size",
          "pages"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          }
        }
      },
      "ManagedTenantList": {
        "type": "object",
        "required": [
          "items",
          "meta"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ManagedTenant"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ListMeta"
          }
        }
      },
      "TenantMember": {
        "type": "object",
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The USER's id - what impersonation takes."
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ManagedTenantDetail": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "status",
          "plan",
          "defaultLocale",
          "version",
          "createdAt",
          "activatedAt",
          "members"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          },
          "defaultLocale": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "activatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TenantMember"
            }
          }
        }
      },
      "Suspended": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "suspended"
            ]
          }
        }
      },
      "ImpersonatedSession": {
        "type": "object",
        "description": "The person's session body (identity's Session) with `impersonating: true` and `operator: {id, displayName}`. No refresh cookie is set.",
        "additionalProperties": true
      },
      "ManagerAuditEntry": {
        "type": "object",
        "required": [
          "id",
          "action",
          "tenantId",
          "actorId",
          "onBehalfOfId",
          "subjectId",
          "requestId",
          "succeeded",
          "failureReason",
          "recordedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "tenantId": {
            "type": "string",
            "nullable": true
          },
          "actorId": {
            "type": "string",
            "nullable": true
          },
          "onBehalfOfId": {
            "type": "string",
            "nullable": true
          },
          "subjectId": {
            "type": "string",
            "nullable": true
          },
          "requestId": {
            "type": "string",
            "nullable": true
          },
          "succeeded": {
            "type": "boolean"
          },
          "failureReason": {
            "type": "string",
            "nullable": true
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ManagerAuditList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ManagerAuditEntry"
            }
          }
        }
      },
      "WorkerStatus": {
        "type": "object",
        "required": [
          "queues",
          "failed"
        ],
        "properties": {
          "queues": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Jobs waiting per queue (available, scheduled or retryable)."
          },
          "failed": {
            "type": "integer",
            "description": "Jobs River discarded after their last retry."
          }
        }
      },
      "OperatorList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Operator"
            }
          }
        }
      },
      "ConsultantList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Consultant"
            }
          }
        }
      },
      "Consultant": {
        "type": "object",
        "required": [
          "id",
          "email",
          "displayName",
          "clients"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "clients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsultantClient"
            }
          }
        }
      },
      "ConsultantClient": {
        "type": "object",
        "required": [
          "tenantId",
          "name"
        ],
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ConsultantChanged": {
        "type": "object",
        "required": [
          "tenantId"
        ],
        "properties": {
          "tenantId": {
            "type": "string"
          }
        }
      },
      "CreateTenantRequest": {
        "type": "object",
        "required": [
          "name",
          "slug"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "CreatedTenant": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "AddMemberRequest": {
        "type": "object",
        "required": [
          "email",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string",
            "maxLength": 200
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "consultant",
              "member"
            ]
          }
        }
      },
      "AddedMember": {
        "type": "object",
        "required": [
          "userId",
          "setPasswordUrl"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "setPasswordUrl": {
            "type": "string",
            "nullable": true,
            "description": "A new account's single-use link. Shown once; nothing keeps it."
          }
        }
      }
    }
  }
}
