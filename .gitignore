# .env and the files derived from it - never committed (.ai/platform/docs/dev-stack.md)
.env
.env.*
!.env.example
docker/**/*.generated.*

# Go
backend/bin/
# the binary `go build` leaves in the directory it runs in (backend/ or backend/cmd/openenu/)
/backend/openenu
/backend/cmd/openenu/openenu
# local storage when the binary runs outside Docker (STORAGE_ROOT defaults to var/storage)
backend/var/
backend/**/*.gen.go.tmp
backend/coverage.out

# Node
node_modules/
.nuxt/
.output/
dist/
# @nuxt/content's build cache (landing/.data/content/contents.sqlite)
.data/
e2e/test-results/
e2e/playwright-report/

# local
*.local
.DS_Store

# generated by make env for compose
docker/api/project.env

# the dev CA and the wildcard certificate (make certs)
docker/certs/

# Playwright output (playwright.config.ts: outputDir .results, report .report)
e2e/.results/
e2e/.report/
e2e/.cache/

# written by make dns-check (importable DNS fixes) and by backup.sh on a server
.out/
backups/

# written by make test, read by make route-coverage
backend/.route-trace

# local scratch space - anything kept for a while and never committed
/temp/
